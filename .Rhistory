if (is.null(b)) {
if (a %in% nms) return(a)
stop("Term not found in model: ", a)
}
nm1 <- paste0(a, ":", b)
nm2 <- paste0(b, ":", a)
if (nm1 %in% nms) return(nm1)
if (nm2 %in% nms) return(nm2)
stop("Interaction not found in model: ", a, " × ", b)
}
# ---------- pull needed pieces from the model ----------
co  <- stats::coef(m_poly)
V   <- stats::vcov(m_poly)
nms <- names(co)
main_var <- "v2x_execorr_l1"
mod_var  <- "v2x_polyarchy"
b1n <- grab_name(nms, main_var)
b3n <- grab_name(nms, main_var, mod_var)
b1  <- unname(co[b1n])
b3  <- unname(co[b3n])
# marginal effect and 95% CI at polyarchy value x
me_at <- function(x){
slope <- b1 + b3 * x
se    <- sqrt(V[b1n, b1n] + (x^2)*V[b3n, b3n] + 2*x*V[b1n, b3n])
data.frame(x = x,
estimate = slope,
conf.low = slope - 1.96*se,
conf.high= slope + 1.96*se)
}
# ---------- representative polyarchy values: tercile means ----------
dem_poly <- d_base %>%
dplyr::filter(!is.na(.data[[mod_var]])) %>%
dplyr::pull(!!mod_var)
qs <- stats::quantile(dem_poly, c(0, 1/3, 2/3, 1), na.rm = TRUE)
bins <- cut(dem_poly, qs, include.lowest = TRUE,
labels = c("Low polyarchy","Medium polyarchy","High polyarchy"))
rep_vals <- data.frame(poly_bin = levels(bins)) %>%
rowwise() %>%
mutate(v2x_polyarchy = mean(dem_poly[bins == poly_bin], na.rm = TRUE)) %>%
ungroup()
mfx_pts <- do.call(rbind, lapply(rep_vals$v2x_polyarchy, me_at))
mfx_pts$poly_bin <- factor(rep_vals$poly_bin,
levels = c("Low polyarchy","Medium polyarchy","High polyarchy"))
# ---------- plot ----------
