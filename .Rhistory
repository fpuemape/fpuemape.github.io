mod_var  <- "v2x_polyarchy"
b1n <- grab_name(nms, main_var)
b3n <- grab_name(nms, main_var, mod_var)
b1  <- unname(co[b1n])
b3  <- unname(co[b3n])
# Function: marginal effect and 95% CI for corruption at a given polyarchy value x
me_at <- function(x){
slope <- b1 + b3 * x
se    <- sqrt(V[b1n,b1n] + (x^2)*V[b3n,b3n] + 2*x*V[b1n,b3n])
data.frame(x = x,
estimate = slope,
conf.low = slope - 1.96*se,
conf.high= slope + 1.96*se)
}
# --- Tercile means of polyarchy in the democratic sample (representative points) ---
dem_poly <- d_base %>% dplyr::filter(!is.na(.data[[mod_var]])) %>% dplyr::pull(!!mod_var)
qs   <- stats::quantile(dem_poly, c(0, 1/3, 2/3, 1), na.rm = TRUE)
bins <- cut(dem_poly, qs, include.lowest = TRUE,
labels = c("Low polyarchy","Medium polyarchy","High polyarchy"))
rep_vals <- data.frame(poly_bin = levels(bins)) %>%
rowwise() %>%
mutate(v2x_polyarchy = mean(dem_poly[bins == poly_bin], na.rm = TRUE)) %>%
ungroup()
mfx_pts <- do.call(rbind, lapply(rep_vals$v2x_polyarchy, me_at))
mfx_pts$poly_bin <- rep_vals$poly_bin
mfx_pts$poly_bin <- factor(mfx_pts$poly_bin,
levels = c("Low polyarchy","Medium polyarchy","High polyarchy"))
# --- Plot (grayscale-friendly, journal style) ---
# Optional: try to use Helvetica if available; otherwise default
font_family <- if ("Helvetica" %in% grDevices::fonts()) "Helvetica" else NULL
## ==== Publication-style marginal effects plot (polyarchy terciles) ====
## assumes: m_poly (interaction model with v2x_execorr_l1 * v2x_polyarchy)
##          d_base (data frame with v2x_polyarchy), and directories exist
suppressPackageStartupMessages({
library(ggplot2)
library(dplyr)
})
# --- helpers to safely grab coefficient names (order-agnostic for the interaction) ---
grab_name <- function(nms, a, b = NULL){
if (is.null(b)) {
if (a %in% nms) return(a)
stop("Term not found in model: ", a)
}
nm1 <- paste0(a, ":", b)
nm2 <- paste0(b, ":", a)
if (nm1 %in% nms) return(nm1)
if (nm2 %in% nms) return(nm2)
stop("Interaction not found in model: ", a, " × ", b)
}
# Identify the main and interaction terms
co  <- stats::coef(m_poly)
V   <- stats::vcov(m_poly)
nms <- names(co)
main_var <- "v2x_execorr_l1"
mod_var  <- "v2x_polyarchy"
b1n <- grab_name(nms, main_var)
b3n <- grab_name(nms, main_var, mod_var)
b1  <- unname(co[b1n])
b3  <- unname(co[b3n])
# Function: marginal effect and 95% CI for corruption at a given polyarchy value x
me_at <- function(x){
slope <- b1 + b3 * x
se    <- sqrt(V[b1n, b1n] + (x^2) * V[b3n, b3n] + 2 * x * V[b1n, b3n])
data.frame(
x = x,
estimate = slope,
conf.low = slope - 1.96 * se,
conf.high = slope + 1.96 * se
)
}
# --- Tercile means of polyarchy in the democratic sample (representative points) ---
dem_poly <- d_base %>%
dplyr::filter(!is.na(.data[[mod_var]])) %>%
dplyr::pull(!!mod_var)
qs   <- stats::quantile(dem_poly, c(0, 1/3, 2/3, 1), na.rm = TRUE)
bins <- cut(
dem_poly, qs, include.lowest = TRUE,
labels = c("Low polyarchy", "Medium polyarchy", "High polyarchy")
)
rep_vals <- data.frame(poly_bin = levels(bins)) %>%
rowwise() %>%
mutate(v2x_polyarchy = mean(dem_poly[bins == poly_bin], na.rm = TRUE)) %>%
ungroup()
mfx_pts <- do.call(rbind, lapply(rep_vals$v2x_polyarchy, me_at))
mfx_pts$poly_bin <- factor(
rep_vals$poly_bin,
levels = c("Low polyarchy", "Medium polyarchy", "High polyarchy")
)
# --- Plot (grayscale-friendly, journal style) ---
# Set a base font if you like (e.g., "Helvetica"), or use NULL for default
font_family <- NULL  # or "Helvetica"
p <- ggplot(mfx_pts, aes(x = poly_bin, y = estimate)) +
geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.4) +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = 0.18, linewidth = 0.6) +
geom_point(shape = 16, size = 3) +
labs(
x = "Regime quality (polyarchy terciles)",
y = "Marginal effect of executive corruption (t−1) on ideological appeals",
caption = "Points are marginal effects at the mean polyarchy within terciles; 95% CIs from a country×year FE model with SEs clustered by country.\nSample limited to democracies (v2x_polyarchy ≥ 0.60)."
) +
theme_classic(base_size = 11, base_family = font_family) +
theme(
axis.title.x = element_text(margin = margin(t = 8)),
axis.title.y = element_text(margin = margin(r = 8)),
plot.caption = element_text(hjust = 0, size = 9, margin = margin(t = 6)),
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10)
)
# Show in viewer
print(p)
# Save high-quality outputs
ggsave("results/main/figs/mfx_polyarchy_terciles.png", p, width = 6.0, height = 4.2, dpi = 300)
ggsave("results/main/figs/mfx_polyarchy_terciles.pdf", p, width = 6.0, height = 4.2, device = grDevices::cairo_pdf)
