geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.4) +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = 0.18, linewidth = 0.6) +
geom_point(shape = 16, size = 3) +
labs(
x = "Regime quality (polyarchy terciles)",
y = "Marginal effect of executive corruption (t−1) on ideological appeals",
caption = "Points: marginal effects at tercile means of polyarchy; 95% CIs from a country×year FE model\nwith SEs clustered by country. Sample limited to democracies (v2x_polyarchy ≥ 0.60)."
) +
theme_classic(base_size = 11) +
theme(
axis.title.x = element_text(margin = margin(t = 8)),
axis.title.y = element_text(margin = margin(r = 8)),
plot.caption = element_text(hjust = 0, size = 9, margin = margin(t = 6)),
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10)
)
# show in Viewer
print(p)
# ---------- robust saves (no Cairo/XQuartz required) ----------
# Ensure output dir exists
dir.create("results/main/figs", recursive = TRUE, showWarnings = FALSE)
# PNG (ragg: crisp antialiasing)
if (!requireNamespace("ragg", quietly = TRUE)) install.packages("ragg", quiet = TRUE)
