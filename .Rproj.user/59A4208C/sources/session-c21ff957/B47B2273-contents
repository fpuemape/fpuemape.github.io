dat_dem_period <- d_base %>%
  dplyr::filter(v2x_polyarchy >= 0.60)

if (nrow(dat_dem_period) == 0L) {
  message("No democratic rows (>= .60); skipping period heterogeneity.")
} else {
  # 1) Build eras from the year column
  yr <- as.numeric(dat_dem_period[[time_var]])
  dat_dem_period$period_era <- cut(
    yr,
    breaks = c(1980, 1990, 2000, 2010, 2017, 2025),  # right-open bins
    right  = FALSE,
    labels = c("1980s", "1990s", "2000s", "2010–2016", "2017–2024")
  )
  dat_dem_period <- dat_dem_period %>% dplyr::filter(!is.na(period_era))
  
  if (nrow(dat_dem_period) == 0L) {
    message("After binning years into eras, no rows remain; skipping.")
  } else {
    # 2) Choose reference period (prefer 2000s, else most frequent)
    has_2000s <- any(as.character(dat_dem_period$period_era) == "2000s")
    ref_per <- if (has_2000s) {
      "2000s"
    } else {
      dat_dem_period %>%
        dplyr::count(period_era, sort = TRUE) %>%
        dplyr::slice(1) %>% dplyr::pull(period_era) %>% as.character()
    }
    
    # 3) Candidate controls from your theory/covariate blocks (intersect with available cols)
    cand_ctrls <- intersect(unique(c(theory_blk, covar_blk)), names(dat_dem_period))
    
    # 4) Diagnose coverage and keep only dense controls (>= .85); relax to .70 if needed
    cov_tbl <- tibble::tibble(
      var   = cand_ctrls,
      cover = sapply(cand_ctrls, function(v) mean(!is.na(dat_dem_period[[v]])))
    ) %>% dplyr::arrange(dplyr::desc(cover))
    
    rhs_dense <- cov_tbl %>% dplyr::filter(cover >= .85) %>% dplyr::pull(var)
    if (length(rhs_dense) < 3L) rhs_dense <- cov_tbl %>% dplyr::filter(cover >= .70) %>% dplyr::pull(var)
    
    # 5) Build interaction and formulas
    slope_period <- paste0("i(period_era, var=", lag1, ", ref='", ref_per, "')")
    fe_rhs_period <- paste(id_var, "+", time_var)
    
    # Helper to compute effective N for a given RHS set
    effN_period <- function(rhs_vec) {
      need <- unique(c(dv_main, lag1, "period_era", rhs_vec, id_var, time_var))
      sum(stats::complete.cases(dat_dem_period[, need, drop = FALSE]))
    }
    
    # 6) Try dense-controls model first
    rhs_use <- intersect(rhs_dense, names(dat_dem_period))
    N_dense <- effN_period(rhs_use)
    
    cat("\n=== Period interaction: effective N (dense controls) ===\n")
    cat("  Controls kept:", ifelse(length(rhs_use)==0, "(none)", paste(rhs_use, collapse=", ")), "\n")
    cat("  Complete-case N:", N_dense, "of", nrow(dat_dem_period), "rows\n")
    
    f_period_dense <- as.formula(paste(
      dv_main, "~", paste(c(slope_period, rhs_use), collapse = " + "), "|", fe_rhs_period
    ))
    
    # 7) If dense spec is too lossy, fall back to interaction-only (no extra controls)
    #    You can tweak the threshold (e.g., require at least 1,500 rows)
    N_thresh <- 1500
    if (N_dense < N_thresh) {
      cat("\n[Info] Dense spec leaves too few rows (", N_dense, " < ", N_thresh,
          "). Fitting lean interaction-only model for transparency.\n", sep = "")
      f_period_lean <- as.formula(paste(
        dv_main, "~", slope_period, "|", fe_rhs_period
      ))
      m_period <- fixest::feols(f_period_lean, data = dat_dem_period,
                                vcov = as.formula(paste0("~", id_var)))
      spec_label <- paste0("Period slopes (ref=", ref_per, "), lean (interaction only)")
    } else {
      m_period <- fixest::feols(f_period_dense, data = dat_dem_period,
                                vcov = as.formula(paste0("~", id_var)))
      spec_label <- paste0("Period slopes (ref=", ref_per, "), with dense covariates")
    }
    
    # 8) Console-only table
    options(modelsummary_factory_default = "kableExtra")
    options(modelsummary_format_numeric_latex = "plain")
    
    tab_per <- modelsummary::modelsummary(
      setNames(list(m_period), spec_label),
      estimate  = "{estimate}{stars}",
      statistic = "({std.error})",
      stars     = c("*" = .10, "**" = .05, "***" = .01),
      gof_omit  = "IC|Log|Adj|AIC|BIC",
      notes     = c(
        paste0("Reference period: ", ref_per, ". Coefficients are the slope of executive corruption (t−1) within each era."),
        "Two-way FE (country and year). SE clustered by country. Democratic sample (v2x_polyarchy ≥ .60)."
      ),
      output    = "markdown"
    )
    print(tab_per)
    
    # 9) Optional: also print a small coverage table to console (bottom 8 by coverage)
    cat("\n=== Lowest-coverage candidate controls (bottom 8) ===\n")
    print(utils::tail(cov_tbl, 8))
  }
