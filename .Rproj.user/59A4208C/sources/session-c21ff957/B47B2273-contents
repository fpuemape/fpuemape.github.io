    }
  )
}
pull_corr <- function(m, term){
  ct <- tryCatch(summary(m)$coeftable, error = function(e) NULL)
  if (is.null(ct) || !term %in% rownames(ct)) return(tibble::tibble(beta=NA,se=NA,p=NA,n=nobs(m)))
  tibble::tibble(beta=ct[term,"Estimate"], se=ct[term,"Std. Error"], p=ct[term,"Pr(>|t|)"], n=nobs(m))
}
