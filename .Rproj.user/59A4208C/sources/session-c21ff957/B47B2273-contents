  # ---- marginal effects curve (continuous 0..1) ----
  grab_name <- function(nms, a, b = NULL){
    if (is.null(b)) { if (a %in% nms) return(a); stop("Term not found: ", a) }
    nm1 <- paste0(a, ":", b); nm2 <- paste0(b, ":", a)
    if (nm1 %in% nms) return(nm1)
    if (nm2 %in% nms) return(nm2)
    stop("Interaction not found: ", a,":",b)
  }
  me_curve_df <- function(model, var_main, moderator, grid=seq(0,1,.01)){
    co <- stats::coef(model); V <- stats::vcov(model); nms <- names(co)
    b1n <- grab_name(nms, var_main)                  # main effect of var_main
    b3n <- grab_name(nms, var_main, moderator)       # interaction term
    b1  <- co[b1n]; b3 <- co[b3n]
    slope <- as.numeric(b1 + b3*grid)
    se    <- sqrt(V[b1n,b1n] + (grid^2)*V[b3n,b3n] + 2*grid*V[b1n,b3n])
    data.frame(x=grid, slope=slope, lo=slope-1.96*se, hi=slope+1.96*se)
  }
  df_me <- me_curve_df(m_poly, var_main = lag1, moderator = "v2x_polyarchy", grid = seq(0, 1, .01))
  
