# Election competitiveness carry-forward
carry_elec <- function(level){
  comp <- if (level == "house") house_comp else pres_comp
  if (!has(comp)) return(invisible(NULL))
  comp_last <- paste0(level,"_comp_last")
  elec_year <- paste0(level,"_elec_year")
  year_last <- paste0(level,"_year_last")
  yrs_since <- paste0(level,"_years_since")
  nonelec   <- paste0(level,"_nonelec")
  d <<- d %>%
    group_by(.data[[id_var]]) %>%
    arrange(.data[[time_var]], .by_group = TRUE) %>%
    mutate(
      !!elec_year := !is.na(.data[[comp]]),
      !!comp_last := zoo::na.locf(.data[[comp]], na.rm = FALSE),
      !!year_last := ifelse(.data[[elec_year]], .data[[time_var]], NA_integer_)
    ) %>%
    tidyr::fill(dplyr::all_of(year_last), .direction = "down") %>%
    mutate(
      !!yrs_since := ifelse(!is.na(.data[[year_last]]),
                            .data[[time_var]] - .data[[year_last]], NA_integer_),
      !!nonelec   := as.integer(!.data[[elec_year]])
    ) %>% ungroup()
}
