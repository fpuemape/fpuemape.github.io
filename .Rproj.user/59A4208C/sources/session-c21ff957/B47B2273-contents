infer_scale <- function(x){
  if(!is.numeric(x)) return("non-numeric")
  mn <- suppressWarnings(min(x, na.rm=TRUE)); mx <- suppressWarnings(max(x, na.rm=TRUE))
  nun <- dplyr::n_distinct(x, na.rm=TRUE)
  if(nun==2) return("binary 0/1")
  if(mn>=0 && mx<=1) return("index 0–1")
  if(mn>=0 && mx<=100 && nun>2) return("0–100 scale")
  "numeric"
}
