  notes     = "DV & RHS standardized within-country; country & year FE; SE clustered by country."
)

wc_sd <- function(x, id) tapply(x, id, sd, na.rm=TRUE)
nonmiss_rate <- sapply(rhs_full, function(v) mean(!is.na(dem_dat[[v]])))
med_wsd      <- sapply(rhs_full, function(v) median(wc_sd(dem_dat[[v]], dem_dat[[id_var]]), na.rm=TRUE))
rhs_keep     <- names(which(nonmiss_rate >= .80 & med_wsd >= .02))
vars_needed  <- c(dv_main, rhs_keep, id_var, time_var)
dem_cc <- dem_dat %>% dplyr::select(dplyr::all_of(vars_needed)) %>% tidyr::drop_na()

resid_tw <- function(var, dat){
  f <- as.formula(paste(var, "~ 1 |", id_var, "+", time_var))
  as.numeric(residuals(fixest::feols(f, data=dat)))
}
df_w <- data.frame(y = resid_tw(dv_main, dem_cc))
for (v in rhs_keep) df_w[[v]] <- resid_tw(v, dem_cc)

lm_w <- lm(y ~ ., data = df_w)
rel  <- relaimpo::calc.relimp(lm_w, type="lmg", rela=TRUE)
lmg_tbl <- sort(rel$lmg, decreasing=TRUE)
write.csv(round(lmg_tbl, 3), "results/appendix/csv/robust_lmg_within.csv")

# ---- NEW: E) Placebo lead (anticipation) ----
dat_dem <- d_base %>% filter(v2x_polyarchy >= .60)
rhs_pl <- intersect(c(lag1, lead1, theory_blk, covar_blk), names(dat_dem))
m_placebo <- fixest::feols(
  as.formula(paste(dv_main, "~", paste(rhs_pl, collapse=" + "),
                   "|", paste(id_var, "+", time_var))),
  data = dat_dem, vcov = vc_id
)
capture.output(fixest::etable(m_placebo, se.below=TRUE, digits=3),
               file = "results/appendix/tables/robust_placebo_lead.txt")

# ---- NEW: F) Two-way clustered SEs (ctry + year) ----
m_twoc <- fixest::feols(
  as.formula(paste(dv_main, "~", paste(c(lag1, rhs_covars), collapse=" + "),
                   "|", paste(id_var, "+", time_var))),
  data = dat_dem, vcov = as.formula(paste0("~ ", id_var, " + ", time_var))
)
capture.output(fixest::etable(m_twoc, se.below=TRUE, digits=3),
               file = "results/appendix/tables/robust_twoway_cluster.txt")

# ---- OPTIONAL: G) Driscoll–Kraay (if desired) ----
vars_needed <- unique(c(dv_main, lag1, rhs_covars, id_var, time_var))
dat_plm <- dat_dem %>% dplyr::select(dplyr::all_of(vars_needed)) %>% tidyr::drop_na()
if (nrow(dat_plm) > 0) {
  f_plm <- as.formula(paste(dv_main, "~", paste(c(lag1, rhs_covars), collapse=" + ")))
  mod_plm <- plm::plm(f_plm, data=dat_plm, index=c(id_var, time_var), model="within", effect="twoways")
  L <- max(1, floor(mean(table(dat_plm[[id_var]]))^(1/3)))
  ct <- lmtest::coeftest(mod_plm, vcov.=plm::vcovSCC(mod_plm, type="HC1", maxlag=L))
  utils::capture.output(print(ct), file="results/appendix/tables/robust_driscoll_kraay.txt")
}

# ---- NEW: H) Country-specific linear trends ----
dat_tr <- dat_dem %>% mutate(year_c = .data[[time_var]] - median(.data[[time_var]], na.rm=TRUE))
f_tr  <- as.formula(paste(
  dv_main, "~", paste(c(lag1, rhs_covars, paste0("i(", id_var, ", year_c)")), collapse=" + "),
  "|", paste(id_var, "+", time_var)
))
m_tr  <- fixest::feols(f_tr, data=dat_tr, vcov = vc_id)
capture.output(fixest::etable(m_tr, se.below=TRUE, digits=3),
               file = "results/appendix/tables/robust_country_trends.txt")

# ---- NEW: I) Leave-one-country-out (jackknife influence) ----
ctys <- sort(unique(na.omit(dat_dem[[id_var]])))
loco <- lapply(ctys, function(cc){
  dd <- dplyr::filter(dat_dem, .data[[id_var]] != cc)
  m  <- tryCatch(fixest::feols(
    as.formula(paste(dv_main, "~", paste(c(lag1, rhs_covars), collapse=" + "),
                     "|", paste(id_var, "+", time_var))),
    data=dd, vcov = vc_id), error=function(e) NULL)
  if (is.null(m)) return(NULL)
  tb <- broom::tidy(m); i <- match(lag1, tb$term)
  data.frame(drop=cc, beta=tb$estimate[i], se=tb$std.error[i])
})
loco <- dplyr::bind_rows(loco)
readr::write_csv(loco, "results/appendix/csv/robust_loco_baseline.csv")

