  dir.create("results/main/figs", showWarnings = FALSE, recursive = TRUE)
  ggplot2::ggsave("results/main/figs/me_polyarchy_streamlined.png", p, width = 7, height = 5, dpi = 300)
  
  # ---- console summary of discrete points ----
  cat("\n--- Marginal effects at representative polyarchy levels (mean within tercile) ---\n")
  print(pts)
